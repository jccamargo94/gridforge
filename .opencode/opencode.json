{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    ".agents/rules/overview.mdc",
    ".agents/rules/python-patterns.mdc"
  ],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "pwd": "allow",
      "uv run pytest*": "allow",
      "uv run ruff*": "allow",
      "uv run ty*": "allow",
      "uv run python*": "allow",
      "uv run uv*": "allow",
      "uv sync*": "allow",
      "uv add*": "allow",
      "uv lock*": "allow",
      "pre-commit*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git checkout*": "allow",
      "git fetch*": "allow",
      "git pull*": "allow",
      "git push*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git remote*": "allow",
      "git worktree*": "allow",
      "gh auth*": "allow",
      "gh issue*": "allow",
      "gh pr*": "allow",
      "gh label*": "allow",
      "gh repo*": "allow",
      "gh api*": "allow",
      "gh view*": "allow",
      "npm run lint*": "allow",
      "npm run test*": "allow",
      "npm run build*": "allow",
      "docker compose*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git reset --hard*": "deny",
      "rm -rf /": "deny",
      "rm -rf ~": "deny"
    }
  }
}
